{
  "name": "@millwork/solver-mcp",
  "version": "0.1.1",
  "description": "Millwork Solver execution MCP server -- the solver_* tools over stdio.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/millworkdev/solver-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
