{
  "name": "@millwork/solver-mcp",
  "version": "0.2.7",
  "description": "Millwork Solver execution MCP server -- the solver_* tools over stdio.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "millwork",
    "solver",
    "ai-agents",
    "llm",
    "stdio",
    "cli"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/millworkdev/solver-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "solver-mcp": "./dist/index.js"
  },
  "imports": {
    "#solver-run-admission": "./dist/sdk/runAdmission.js",
    "#solver-run-authorization-boundary": "./dist/sdk/runAuthorizationBoundary.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
